<script>
function b(s){var r=atob(s),a=new Uint8Array(r.length);for(var i=0;i<r.length;i++)a[i]=r.charCodeAt(i);return a;}
function card(v){
  var d=document.createElement('div'); d.className='card';
  d.innerHTML='<div class="thumb"><img loading="lazy" src="https://i.ytimg.com/vi/'+v.id+
    '/mqdefault.jpg" alt=""><div class="play">&#9654;</div></div>'+
    '<div class="body"><div class="t"></div><div class="meta"><span class="d">'+
    (v.date||'')+(v.views!=null?('<span class="v">'+v.views+' пр.</span>'):'')+
    '</span><button type="button" class="cop">Скопировать</button></div></div>';
  d.querySelector('.t').textContent=v.title||'';
  d.dataset.t=(v.title||'').toLowerCase();
  d.onclick=function(){open_player(d,v);};
  var cp=d.querySelector('.cop');
  cp.onclick=function(ev){
    ev.stopPropagation();                       // клик по кнопке не должен запускать видео
    var b=this;
    navigator.clipboard.writeText('https://youtu.be/'+v.id).then(function(){
      b.textContent='Скопировано'; b.classList.add('ok');
      setTimeout(function(){b.textContent='Скопировать'; b.classList.remove('ok');},1600);
    }).catch(function(){ b.textContent='Не вышло'; });
  };
  return d;
}
var OPEN_PLAYER=null;
function close_player(){ if(OPEN_PLAYER){OPEN_PLAYER.p.replaceWith(OPEN_PLAYER.card); OPEN_PLAYER=null;} }
document.addEventListener('keydown',function(e){
  if(e.key!=='Escape') return;
  var q=document.getElementById('q');
  if(q&&q.classList.contains('open')&&document.activeElement===q){ toggleSearch(); return; }
  close_player();
});
// Открытый с диска файл YouTube не пускает: у страницы нет адреса сайта, и плеер
// отвечает Error 153. Поэтому локально карточка просто уводит на YouTube.
var LOCAL = location.protocol === 'file:';
function open_player(cardEl,v){
  if(LOCAL){ window.open('https://youtu.be/'+v.id,'_blank','noopener'); return; }
  close_player();                      // один плеер за раз: два звука одновременно никому не нужны
  var p=document.createElement('div'); p.className='player';
  p.innerHTML='<iframe allowfullscreen allow="fullscreen; picture-in-picture" '+
    'src="https://www.youtube-nocookie.com/embed/'+v.id+'?rel=0&autoplay=1"></iframe>'+
    '<div class="bar"><button type="button" class="cl">Свернуть</button>'+
    '<span style="flex:1"></span>'+
    '<button type="button" class="cp">Скопировать ссылку</button>'+
    '<a target="_blank" rel="noopener" href="https://youtu.be/'+v.id+'">Открыть на YouTube &rarr;</a></div>';
  cardEl.replaceWith(p);
  OPEN_PLAYER={p:p,card:cardEl};
  p.querySelector('.cl').onclick=close_player;
  p.querySelector('.cp').onclick=function(){
    var b=this;
    navigator.clipboard.writeText('https://youtu.be/'+v.id).then(function(){
      b.textContent='Скопировано'; setTimeout(function(){b.textContent='Скопировать ссылку';},1600);
    }).catch(function(){ b.textContent='Не вышло'; });
  };
}
function toggleSearch(){
  var q=document.getElementById('q'), m=document.getElementById('mag');
  var open=q.classList.toggle('open'); m.classList.toggle('on',open);
  if(open){q.focus();} else {q.value=''; filter();}
}
function show(which){
  ['open','partners'].forEach(function(k){
    document.getElementById('pane-'+k).style.display = (k===which)?'':'none';
    document.getElementById('tab-'+k).classList.toggle('on', k===which);
  });
  if(which==='partners'){var i=document.getElementById('p'); if(i&&i.offsetParent) i.focus();}
}
function fill(g,items){
  g.innerHTML='';
  if(!items.length){g.innerHTML='<div class="empty">пока пусто</div>';return;}
  items.forEach(function(v){g.appendChild(card(v));});
}
// Поиск прячет карточки и целые разделы, где ничего не нашлось. Работает только
// по тому, что уже отрисовано: запертая вкладка так и остаётся запертой.
function filter(){
  var q=(document.getElementById('q').value||'').trim().toLowerCase();
  document.querySelectorAll('.sec').forEach(function(sec){
    var shown=0;
    sec.querySelectorAll('.card').forEach(function(c){
      var ok=!q||(c.dataset.t||'').indexOf(q)>=0;
      c.style.display=ok?'':'none'; if(ok)shown++;
    });
    sec.style.display=(q&&!shown)?'none':'';
  });
  counts();
}
function counts(){
  ['open','partners'].forEach(function(k){
    var n=document.querySelectorAll('#'+k+' .card').length;
    var el=document.getElementById('cnt-'+k);
    if(el) el.textContent=n?n:'';
  });
}
function render(box,sections){
  box.innerHTML='';
  (sections||[]).forEach(function(s){
    var sec=document.createElement('div'); sec.className='sec'; box.appendChild(sec);
    if(s.title){var h=document.createElement('div'); h.className='sech'; h.textContent=s.title; sec.appendChild(h);}
    if(s.sub){var p=document.createElement('div'); p.className='secsub'; p.textContent=s.sub; sec.appendChild(p);}
    var items=(s.items||[]).slice();
    var g=document.createElement('div'); g.className='grid';
    // Переключатель нужен там, где список длинный. На двух видео он лишний шум.
    if(items.length>5){
      var sr=document.createElement('div'); sr.className='sorter';
      [['Свежие',function(a,b){return (b.date||'').localeCompare(a.date||'');}],
       ['Популярные',function(a,b){return (b.views||0)-(a.views||0);}]
      ].forEach(function(m,n){
        var btn=document.createElement('button'); btn.type='button'; btn.textContent=m[0];
        if(n===0) btn.className='on';
        btn.onclick=function(){
          sr.querySelectorAll('button').forEach(function(x){x.classList.remove('on');});
          btn.classList.add('on'); fill(g,items.slice().sort(m[1]));
        };
        sr.appendChild(btn);
      });
      sec.appendChild(sr);
    }
    sec.appendChild(g);
    fill(g,items);
  });
  counts();
}
var OPEN_FB=__OPEN__, ENC_FB=__ENC__;
