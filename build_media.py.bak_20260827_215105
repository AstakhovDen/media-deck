# -*- coding: utf-8 -*-
r"""Собирает Media Deck из media/playlist.json.

ЗАЧЕМ
  Страница Media Deck статична и НЕ пересобирается ради каждого видео.
  Меняются только два маленьких файла рядом с ней:
    open.json      - открытый этаж, простым текстом
    partners.enc   - этаж партнёров, зашифрован тем же паролем, что First Income
  Браузер сам подтягивает их при заходе. Добавилось видео - улетело 200 байт,
  а не вся страница.

ПОЧЕМУ ЭТАЖ ПАРТНЁРОВ ЗАШИФРОВАН ОТДЕЛЬНЫМ ФАЙЛОМ
  Если положить список партнёрских видео простым текстом рядом с закрытой
  страницей, он читается без пароля. Шифруется именно список.

ИСТОЧНИК ПРАВДЫ
  C:\TychoSector\media\playlist.json - туда пишет скрипт заливки.

ЗАПУСК
  двойной клик по "ОБНОВИТЬ MEDIA DECK.bat"
"""
import base64, hashlib, io, json, os
from cryptography.hazmat.primitives.ciphers.aead import AESGCM

PASSWORD = "rivendell25"       # тот же, что у First Income и Workflow Boards
ITER = 310000

# Разделы страницы. Порядок здесь = порядок на экране.
# floor решает доступ: open - видно всем, partners - только по паролю.
# Видео попадает в раздел по полю "section" в playlist.json; нет поля -
# едет в первый раздел своего этажа.
SECTIONS = [
    {"key": "grand-opening",
     "title": "Помогаем людям жить лучше",
     "sub": "",
     "floor": "open"},
    {"key": "partners",
     "title": "Обучение и разборы",
     "sub": "Core Run Call, вебинары команды",
     "floor": "partners"},
    {"key": "after-seminar",
     "title": "Встречи после семинаров",
     "sub": "Разборы с Zbigniew и Sophia Rek",
     "floor": "partners"},
    {"key": "biz-plan",
     "title": "Бизнес-план и Info Session",
     "sub": "Записи презентаций для кандидатов",
     "floor": "partners"},
]

ROOT = r"C:\TychoSector"
SRC = os.path.join(ROOT, "media", "playlist.json")
REPO = os.path.dirname(os.path.abspath(__file__))
b64 = lambda x: base64.b64encode(x).decode()


def load():
    if not os.path.exists(SRC):
        return []
    return json.load(io.open(SRC, encoding="utf-8")).get("items", [])


def encrypt(text):
    salt, iv = os.urandom(16), os.urandom(12)
    key = hashlib.pbkdf2_hmac("sha256", PASSWORD.strip().lower().encode(), salt, ITER, 32)
    ct = AESGCM(key).encrypt(iv, text.encode("utf-8"), None)
    return {"salt": b64(salt), "iv": b64(iv), "data": b64(ct), "iter": ITER}


def group(items, floor):
    """Раскладывает видео по разделам одного этажа, свежее сверху."""
    secs = [s for s in SECTIONS if s["floor"] == floor]
    if not secs:
        return []
    mine = [i for i in items if (i.get("floor") or "open") == floor]
    out = []
    for n, sec in enumerate(secs):
        got = [i for i in mine
               if i.get("section") == sec["key"] or (not i.get("section") and n == 0)]
        # Порядок по умолчанию - свежее сверху. Переключатель на странице
        # умеет пересортировать по просмотрам, не трогая файлы.
        got.sort(key=lambda i: (i.get("date", ""), i.get("title", "")), reverse=True)
        out.append({"title": sec["title"], "sub": sec["sub"], "items": got})
    return out


def build():
    items = load()
    op = group(items, "open")
    pt = group(items, "partners")

    open_js = json.dumps({"sections": op}, ensure_ascii=False)
    enc_js = json.dumps(encrypt(json.dumps({"sections": pt}, ensure_ascii=False)))

    io.open(os.path.join(REPO, "open.json"), "w", encoding="utf-8", newline="\n").write(open_js)
    io.open(os.path.join(REPO, "partners.enc"), "w", encoding="utf-8", newline="\n").write(enc_js)

    # Те же данные вшиваются в страницу запасным вариантом. Нужны, когда index.html
    # открывают файлом с диска: браузер запрещает fetch с file://, и без запаски
    # локальная проверка показывала бы пустую медиатеку. На сервере выигрывает fetch,
    # поэтому добавленное видео видно и без пересборки страницы.
    page = PAGE.replace("__OPEN__", open_js).replace("__ENC__", enc_js)
    io.open(os.path.join(REPO, "index.html"), "w", encoding="utf-8", newline="\n").write(page)
    return sum(len(x["items"]) for x in op), sum(len(x["items"]) for x in pt)


